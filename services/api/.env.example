APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=postgresql+asyncpg://accessforge:accessforge@localhost:5432/accessforge
REDIS_URL=redis://localhost:6379/0
AUTO_CREATE_DB=true
CORS_ORIGINS=http://localhost:3000
BACKEND_TOKEN_ISSUER=accessforge-web
BACKEND_TOKEN_AUDIENCE=accessforge-api
BACKEND_TOKEN_PUBLIC_KEYS_JSON={}
ALLOWED_WEB_ORIGINS=http://localhost:3000
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PRIVATE=accessforge-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# The SDK makes a single bounded attempt; durable cleanup retries are recorded
# by the deletion outbox rather than hidden in the storage client.
S3_CONNECT_TIMEOUT_SECONDS=10
S3_READ_TIMEOUT_SECONDS=40
ASSET_PRESIGN_TTL_SECONDS=600
ASSET_MAX_BYTES=100000000
ASSET_RETENTION_DAYS=30
# Optional model-provider configuration. These variables belong only to the API/worker
# environment. Never copy a provider key, BYOK encryption key, or custom endpoint into
# apps/web/.env.local or any NEXT_PUBLIC_* variable.
#
# Leave DEFAULT_MODEL_PROVIDER=none to keep AI disabled. A configured managed key never
# bypasses project-level ai_provider_sharing consent. Raw project media is not an allowed
# Phase 3 provider input.
DEFAULT_MODEL_PROVIDER=none
# Required only when storing BYOK credentials. Generate a base64-encoded 32-byte value;
# keep it in a backend secret store and plan rotation before production use.
MODEL_CREDENTIAL_ENCRYPTION_KEY=
# Phase 6 remains default-denied. This separate base64-encoded 32-byte key is
# required only for server-side revalidation of a sealed risk context; it is
# not a switch that approves an artifact or physical use.
RISK_CONTEXT_ENCRYPTION_KEY=
# Do not enable either flag for normal development or deployment. A qualified
# reviewer release control, non-human evidence, current validation, and exact
# lineage remain separate fail-closed requirements even when they are true.
PHASE6_CONTROLLED_VALIDATION_ENABLED=false
PHASE6_EXPORT_ENABLED=false
PHASE6_REVIEWER_ROLES=safety_reviewer
# Deployment-managed provider keys are optional. Keep values blank in this checked-in
# example; use Render secret settings or a gitignored local environment file instead.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_FAST_MODEL=
OPENAI_REASONING_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=
ANTHROPIC_REASONING_MODEL=
GOOGLE_API_KEY=
GOOGLE_FAST_MODEL=
GOOGLE_REASONING_MODEL=
# Comma-separated exact hostnames allowed for custom OpenAI-compatible endpoints. Hosted
# mode requires HTTPS/public targets and rejects redirects, URL credentials, query data,
# fragments, and private/loopback/link-local targets. The unsafe flag is self-hosted-only.
CUSTOM_MODEL_ENDPOINT_ALLOWLIST=
ALLOW_UNSAFE_CUSTOM_MODEL_ENDPOINTS=false
MODEL_PROVIDER_TIMEOUT_SECONDS=20
